# Docker 部署配置（复制为 .env）
# 本仓库发布的 Docker Hub 镜像地址；参见 README 的部署说明。
# 本 fork 不发布公共镜像：默认从仓库 Dockerfile 本地构建。
# 只有在自建了私有镜像仓库时，才需要把这两个值改成自己的。
XFSRC_IMAGE=xfsrc
XFSRC_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
